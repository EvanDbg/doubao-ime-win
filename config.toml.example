# Doubao Voice Input - Configuration File
# 豆包语音输入配置文件

[general]
# 开机自启动
auto_start = false
# 语言
language = "zh-CN"

[hotkey]
# 热键模式: "combo" (组合键) 或 "double_tap" (单键触发)
mode = "combo"
# 组合键 (当 mode = "combo" 时生效)
combo_key = "Ctrl+Shift+V"
# 触发键，单击/双击/长按共用 (Trigger key, 当 mode = "double_tap" 时生效)
double_tap_key = "Ctrl"
# 双击间隔 (毫秒)
double_tap_interval = 300
# 触发方式 (Trigger gesture, 当 mode = "double_tap" 时生效): "single" 单击 / "double" 双击 / "hold" 长按说话，松开停止
# 长按仅支持 Ctrl/Shift/Alt；其他键回退为双击 (Hold requires a modifier key; other keys fall back to double-tap)
trigger = "double"

[floating_button]
# 是否显示悬浮按钮
enabled = true
# 悬浮按钮位置 (像素)
position_x = 100
position_y = 100

[asr]
# 是否启用 VAD (语音活动检测)
vad_enabled = true
