# Doubao Voice Input - Configuration File
# 豆包语音输入配置文件

[general]
# 开机自启动
auto_start = false
# 语言
language = "zh-CN"

[hotkey]
# 触发动作: "voice_input" (本程序)、"official_hold" (按住时发送右 Alt) 或 "official_hands_free" (点按左 Ctrl+Win)
# 两种官方动作仅支持 raw 自定义按键：触发按键由本程序独占并转发官方快捷键，
# 不会启动或显示本程序的录音窗口
action = "voice_input"
# 绑定来源: "standard" (标准快捷键) 或 "raw" (Windows 非标准按键)
binding = "standard"
# 标准热键模式: "combo" (组合键) 或 "double_tap" (双击)
mode = "combo"
# 组合键 (当 mode = "combo" 时生效)
combo_key = "Ctrl+Shift+V"
# 双击键 (当 mode = "double_tap" 时生效)
double_tap_key = "Ctrl"
# 双击间隔 (毫秒)
double_tap_interval = 300
# 非标准按键由设置窗口“录入非标准按键”自动填写
raw_vk_code = 0
raw_scan_code = 0
raw_extended = false
# 非标准按键按下时切换录音状态

[floating_button]
# 是否显示悬浮按钮
enabled = true
# 悬浮按钮位置 (像素)
position_x = 100
position_y = 100

[asr]
# 是否启用 VAD (语音活动检测)
vad_enabled = true
# WebRTC AEC3 回声消除；需要 Windows 默认扬声器 loopback，失败时自动降级
aec_enabled = false
# VAD 语音结束后的尾音保留窗口（毫秒）；本地用于活动状态平滑，同时透传云端 ASR
end_smooth_window_ms = 800
# 编码前固定麦克风增益（0.25-4.0），1.0 保持原始电平
post_ratio_gain = 1.0
# 音质: "standard" (16kHz) 或 "high_quality" (24kHz)
audio_quality = "standard"
# 标点: "smart", "spaces", "no_sentence_final", "preserve"
punctuation_mode = "smart"

[cloud]
# 将 ASR final 异步发送给 NER，用于后续上下文和候选优化；不会修改已提交文本
ner_enabled = false
# 会话结束后流式润色口水词、明显同音词和语序；关闭时仅保留 ASR 原文
auto_polish_enabled = false
# 是否读取光标前后的文本作为校正上下文
llm_context_enabled = false
# 是否使用自定义 OpenAI 兼容 API；false 使用内置豆包 Scene 5 润色和本机设备凭据
llm_custom_api_enabled = false
# 仅在 llm_custom_api_enabled = true 时使用以下连接和推理参数
llm_base_url = ""
llm_api_key = ""
llm_model = ""
llm_thinking_mode = "omit" # "omit", "disabled", "enabled"
llm_reasoning_effort = "" # "", "low", "medium", "high"
